---
import "@fontsource-variable/roboto";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Type anything — a typing instrument</title>
    <meta
      name="description"
      content="A typing instrument. Every key is a note, every finished word moves the chord, and your typing speed sets the tempo. Nothing you press is wrong."
    />
    <meta property="og:image" content="./card.png" />
  </head>
  <body>
    <nav aria-label="Skip links">
      <a href="#main">Skip to the instrument</a>
    </nav>
    <main id="main">
      <h1>Type anything</h1>
      <p id="hint">Tap, or press a key. Every one is a note, and none of them is wrong.</p>

      <div id="stage" class="stage"></div>

      <input
        id="keys"
        class="keys"
        type="text"
        aria-label="Type here to play"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        inputmode="text"
      />

      <p class="readout">
        <span id="tempo" class="tempo">50 bpm</span>
        <button id="mute" class="mute" type="button" aria-pressed="false">sound on</button>
      </p>
    </main>
    <script src="../main.ts"></script>
  </body>
</html>
